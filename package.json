{
  "name": "kunnskapsbygget",
  "version": "1.0.0",
  "description": "Kunnskapsbygget – NORMIA AI panel",
  "author": "Normia-jb",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
